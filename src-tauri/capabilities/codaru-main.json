{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "codaru-main",
  "description": "Only the local main host can service Codaru's CLI and show user-selected document dialogs.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "codaru:allow-agent-poll",
    "codaru:allow-agent-respond",
    "codaru:allow-save-document",
    "codaru:allow-open-document"
  ]
}
