{
  "name": "codaru-mockup",
  "version": "0.10.0",
  "type": "module",
  "main": "./dist/codaru.js",
  "types": "./dist/types/embed.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/embed.d.ts",
      "import": "./dist/codaru.js"
    },
    "./dist/*": "./dist/*",
    "./core": {
      "types": "./dist/types/editor-core.d.ts",
      "import": "./dist/core.js"
    },
    "./preview": {
      "types": "./dist/types/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./svg": {
      "types": "./dist/types/screen-svg.d.ts",
      "import": "./dist/svg.js"
    },
    "./modular": {
      "types": "./dist/types/modular.d.ts",
      "import": "./dist/modular.js"
    },
    "./assets": {
      "types": "./dist/types/asset-export.d.ts",
      "import": "./dist/assets.js"
    },
    "./aru": {
      "types": "./dist/types/aru.d.ts",
      "import": "./dist/aru.js"
    },
    "./styles": {
      "types": "./dist/types/style-package.d.ts",
      "import": "./dist/styles.js"
    },
    "./identity": {
      "types": "./dist/types/identity-view.d.ts",
      "import": "./dist/identity.js"
    },
    "./comments": {
      "types": "./dist/types/comments-view.d.ts",
      "import": "./dist/comments.js"
    },
    "./experience": {
      "types": "./dist/types/experience-view.d.ts",
      "import": "./dist/experience.js"
    },
    "./fonts": {
      "types": "./dist/types/font-api.d.ts",
      "import": "./dist/fonts.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "scripts"
  ],
  "description": "Editor visual embebible sin dependencias de interfaz en ejecuci\u00f3n",
  "license": "BSD-3-Clause",
  "author": "fsaldivar-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsaldivar-dev/codaru-mockup.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/fsaldivar-dev/codaru-mockup#readme",
  "bugs": {
    "url": "https://github.com/fsaldivar-dev/codaru-mockup/issues"
  },
  "keywords": [
    "tauri",
    "mockup",
    "wireframe",
    "design",
    "editor",
    "ui-kit",
    "ai",
    "svg"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "node ./scripts/verify-package.mjs"
  },
  "bin": {
    "codaru-assets": "scripts/copy-assets.mjs",
    "codaru-aru": "scripts/prepare-aru.mjs"
  }
}
