circle ring { at 288 203; radius 109; fill none; stroke #E76C24 22; }
circle ringInner { at 288 203; radius 78; fill none; stroke #D0D2C9 2; }
path play { move 269 162; line 332 204; line 269 246; close; fill #2F3534;  }
rect meter { at 478 200; size 6 170; corner 3; fill #E76C24;  }
rect line { at 89 200; size 2 90; corner 1; fill #D0D2C9;  }
