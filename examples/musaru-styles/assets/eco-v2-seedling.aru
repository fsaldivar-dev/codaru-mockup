// Musaru Frutiger Eco · original editable botanical forms.
canvas 124 148
background none
gradient leaf linear 110 { stop 0 #ECF4BE; stop 0.4 #AFD07B; stop 0.6 #6B995C; stop 1 #34674A }
gradient tender linear 45 { stop 0 #F6F7D5; stop 0.55 #CDE09E; stop 1 #8FB574 }
gradient glass linear 100 { stop 0 #FFFFFFAF; stop 0.45 #D9E8C64D; stop 0.78 #C1D6B34D; stop 1 #F6FBE2CC }
gradient earth linear 90 { stop 0 #EFF0D5; stop 0.55 #DFE5BE; stop 1 #B8CA9B }
path stem { move 59 137; curve 60 94 44 59 67 14; fill none; stroke #44754E 3; cap round; }
path leafA { move 57 85; curve 12 93 6 54 13 33; curve 52 32 69 54 57 85; close; fill leaf; }
path leafB { move 58 62; curve 49 29 74 15 111 18; curve 114 50 90 69 58 62; close; fill tender; }
path veins { move 19 43; quad 41 61 57 85; move 62 56; quad 82 40 101 26; fill none; stroke #F3F7D4 2; cap round; }
ellipse seedBed { at 59 138; size 77 12; fill earth; }
