// Musaru POP: bespoke control, original editable paths
canvas 48 48
background none
path a { move 5 11; curve 20 5 25 42 40 37; move 5 37; curve 21 41 25 8 40 11; fill none; stroke #252036 4; cap round; }
path tips { move 32 5; line 44 11; line 34 17; close; move 33 31; line 44 37; line 33 43; close; fill #252036; }

