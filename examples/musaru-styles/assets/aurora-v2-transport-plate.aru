// Musaru Frutiger Aurora · original editable light and glass vector.
canvas 520 108
background none
gradient ribbon linear 0 { stop 0 #887BD5; stop 0.3 #B1ACF6; stop 0.65 #8EE4D6; stop 1 #D8F9E8 }
gradient crystal linear 90 { stop 0 #A7ADDE; stop 0.35 #6575AA; stop 0.39 #344F74; stop 1 #182840 }
gradient edge linear 0 { stop 0 #F4E8FF; stop 0.5 #AABAF8; stop 1 #D4FFF1 }
path plate { move 31 22; curve 151 -5 284 13 492 24; quad 520 43 498 81; curve 317 90 180 126 27 96; quad 2 65 31 22; close; fill #253652D9; stroke #B2D7E455 1; cap round; }
path fold { move 31 22; curve 181 0 330 16 491 25; line 478 36; curve 278 23 167 14 25 42; close; fill #E2E8FF22; }
path shine { move 31 94; curve 179 124 325 83 490 82; fill none; stroke #B6F5D99A 1; cap round; }
