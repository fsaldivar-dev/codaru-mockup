// Musaru Aero · original editable vector. Sky and land, no water.
canvas 64 64
background none
gradient chrome linear 90 { stop 0 #FFFFFF; stop 0.42 #E4F3FA; stop 0.52 #A3C6DB; stop 1 #F4FCFF }
gradient jewel linear 90 { stop 0 #99E4FF; stop 0.46 #39B6ED; stop 0.5 #137ABF; stop 1 #095E94 }
gradient green linear 90 { stop 0 #ECFF97; stop 0.5 #A5D753; stop 0.52 #70AD2C; stop 1 #4A8822 }
circle rim { at 32 32; radius 30; fill chrome; stroke #6FAAC8 1; }
circle blueGlass { at 32 32; radius 26; fill jewel; stroke #177BB1 1; }
ellipse cap { at 32 17; size 37 15; fill #FFFFFF80; }
rect left { at 25 34; size 7 23; corner 1; fill #06426B; }
rect right { at 39 34; size 7 23; corner 1; fill #06426B; }
rect leftInset { at 24 32; size 6 23; corner 1; fill #FFFFFF; }
rect rightInset { at 38 32; size 6 23; corner 1; fill #FFFFFF; }
