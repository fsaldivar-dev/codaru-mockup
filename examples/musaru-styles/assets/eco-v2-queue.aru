// Musaru Frutiger Eco · original editable botanical forms.
canvas 96 96
background none
gradient leaf linear 110 { stop 0 #ECF4BE; stop 0.4 #AFD07B; stop 0.6 #6B995C; stop 1 #34674A }
gradient tender linear 45 { stop 0 #F6F7D5; stop 0.55 #CDE09E; stop 1 #8FB574 }
gradient glass linear 100 { stop 0 #FFFFFFAF; stop 0.45 #D9E8C64D; stop 0.78 #C1D6B34D; stop 1 #F6FBE2CC }
gradient earth linear 90 { stop 0 #EFF0D5; stop 0.55 #DFE5BE; stop 1 #B8CA9B }
path leafRowA { move 14 17; curve 30 12 43 16 44 28; curve 32 35 19 32 14 17; close; fill leaf; }
path leafRowB { move 14 41; curve 30 36 43 40 44 52; curve 32 59 19 56 14 41; close; fill tender; }
path leafRowC { move 14 65; curve 30 60 43 64 44 76; curve 32 83 19 80 14 65; close; fill leaf; }
path rows { move 54 24; line 83 24; move 54 48; line 83 48; move 54 72; line 76 72; fill none; stroke #254738 3; cap round; }
