circle tick4 { at 52.5 182.27; radius 2.5; fill #D6F03D; }
circle tick5 { at 17.73 147.5; radius 2.5; fill #D6F03D; }
circle tick6 { at 5.0 100.0; radius 2.5; fill #D6F03D; }
