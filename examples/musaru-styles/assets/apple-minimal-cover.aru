// Musaru · Apple minimalista · original editable cover
canvas 600 400
background none
gradient porcelain linear 110 { stop 0 #FFFFFF; stop 0.65 #F1F1F4; stop 1 #DBDCE2 }
circle record { at 300 200; radius 142; fill porcelain;  }
circle groove { at 300 200; radius 111; fill none; stroke #D5D5DC 1; }
circle center { at 300 200; radius 38; fill #E84C66;  }
circle hole { at 300 200; radius 6; fill #FFFFFF;  }
