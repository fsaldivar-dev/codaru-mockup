// Musaru Memphis · original editable printed geometry.
canvas 48 48
background none
rect bar { at 12 24; size 10 32; corner 0; fill #233BC7; }
path triangle { move 23 8; line 43 40; line 23 40; close; fill #F3868F; }
circle dot { at 36 12; radius 5; fill #20212A; }
path foot { move 5 44; line 43 44; fill none; stroke #20212A 2.5; cap round; }
