// Musaru Dark Aero · original editable hi-fi vector.
canvas 64 64
background none
gradient steel linear 90 { stop 0 #E1EAF1; stop 0.27 #6D7C8A; stop 0.49 #AEBBC6; stop 0.51 #3B4855; stop 1 #B3C1CD }
gradient piano linear 90 { stop 0 #3D4955; stop 0.43 #171D27; stop 0.46 #070A0F; stop 1 #151D28 }
gradient ice linear 90 { stop 0 #DCFCFF; stop 0.43 #67CBE7; stop 0.48 #1B6B91; stop 1 #082E47 }
rect metalEdge { at 32 32; size 60 56; corner 9; fill steel; }
rect glassKey { at 32 31; size 56 52; corner 7; fill piano; }
path upperHighlight { move 11 11; quad 32 6 53 11; fill none; stroke #B5D6E066 1; cap round; }
path inlay { move 45 18; line 27 29; line 45 40; close; move 25 18; line 20 18; line 20 40; line 25 40; close; fill #C5D4DF; }
path statusLight { move 23 54; line 41 54; fill none; stroke #83E8FF 2; cap round; }
