// Musaru orbital receiver · original editable industrial assembly.
canvas 92 84
background none
gradient titanium linear 90 { stop 0 #73848C; stop 0.08 #43545F; stop 0.46 #273944; stop 0.88 #23333D; stop 1 #101D26 }
gradient bezel linear 90 { stop 0 #16252E; stop 0.46 #0B161F; stop 1 #72858D }
gradient metal linear 90 { stop 0 #D2DBDC; stop 0.2 #80939D; stop 0.49 #4A5D69; stop 0.51 #273A47; stop 0.8 #6A7E88; stop 1 #B0C0C6 }
gradient key linear 90 { stop 0 #5A6F7A; stop 0.15 #314753; stop 0.85 #1B303D; stop 1 #10222E }
gradient amber linear 90 { stop 0 #FFE0AB; stop 0.2 #FFD18A; stop 0.8 #F3AF55; stop 1 #D58A32 }
path socket { move 8 0; line 84 0; line 92 8; line 92 76; line 84 84; line 8 84; line 0 76; line 0 8; close; fill #091923; }
path edge { move 9 4; line 83 4; line 88 9; line 88 75; line 83 80; line 9 80; line 4 75; line 4 9; close; fill #986323; }
path face { move 10 5; line 82 5; line 87 10; line 87 70; line 82 75; line 10 75; line 5 70; line 5 10; close; fill amber; }
rect left { at 35 37; size 6 27; corner 1; fill #101B22; }
rect right { at 57 37; size 6 27; corner 1; fill #101B22; }
path bottomHighlight { move 15 69; line 77 69; fill none; stroke #FFE7C0 1; cap round; }
