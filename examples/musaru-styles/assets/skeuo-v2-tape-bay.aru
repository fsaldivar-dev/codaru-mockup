// Musaru Skeuomorphic · original editable physical geometry.
canvas 500 242
background none
gradient walnut linear 0 { stop 0 #5B3020; stop 0.16 #895036; stop 0.38 #A56642; stop 0.62 #78422C; stop 0.84 #A46643; stop 1 #5C3425 }
gradient brass linear 90 { stop 0 #F3E4BA; stop 0.19 #C6AC73; stop 0.48 #E5D4AA; stop 0.52 #9D8356; stop 0.9 #D5BE8C; stop 1 #88724C }
gradient brushed linear 90 { stop 0 #EEE8DC; stop 0.12 #D5CFC3; stop 0.8 #BDB7AC; stop 1 #999488 }
gradient keycap linear 90 { stop 0 #FAF3E5; stop 0.68 #DED4C2; stop 1 #AEA596 }
gradient blackkey linear 90 { stop 0 #4B4D47; stop 0.28 #343831; stop 1 #20231F }
gradient portable linear 90 { stop 0 #D8CBB0; stop 0.38 #C5B797; stop 0.88 #B2A17F; stop 1 #8F8065 }
rect shadow { at 250 123; size 496 236; corner 9; fill #5A4830; }
rect lip { at 250 119; size 490 232; corner 8; fill #EFE3C1; }
rect frame { at 250 119; size 476 218; corner 6; fill #31332D; }
rect label { at 250 48; size 434 62; corner 4; fill #F6EBD4; }
rect glass { at 250 145; size 431 106; corner 18; fill #1B211E; }
path tape { move 105 145; line 395 145; move 114 151; line 386 151; fill none; stroke #796044 3; cap round; }
path lower { move 135 201; line 365 201; line 381 219; line 119 219; close; fill #343B33; }
circle rollerA { at 151 210; radius 7; fill #AAA591; }
circle rollerB { at 349 210; radius 7; fill #AAA591; }
path reflection { move 45 101; line 448 101; line 430 111; line 45 111; close; fill #F9F1DC16; }
