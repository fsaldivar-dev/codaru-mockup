// Musaru Cyberpunk · original editable nocturnal frequency geometry.
canvas 320 18
background none
rect remaining { at 160 9; size 316 4; corner 0; fill #3B5058; }
rect played { at 67 9; size 130 4; corner 0; fill #D5FF48; }
path pointer { move 132 2; line 132 16; fill none; stroke #F77EA8 3; cap round; }
