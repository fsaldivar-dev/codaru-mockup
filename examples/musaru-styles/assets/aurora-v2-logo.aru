// Musaru Frutiger Aurora · original editable light and glass vector.
canvas 96 96
background none
gradient ribbon linear 0 { stop 0 #887BD5; stop 0.3 #B1ACF6; stop 0.65 #8EE4D6; stop 1 #D8F9E8 }
gradient crystal linear 90 { stop 0 #A7ADDE; stop 0.35 #6575AA; stop 0.39 #344F74; stop 1 #182840 }
gradient edge linear 0 { stop 0 #F4E8FF; stop 0.5 #AABAF8; stop 1 #D4FFF1 }
path outerFold { move 8 64; curve 19 19 52 2 75 15; curve 89 24 84 45 70 57; curve 63 65 67 77 88 81; curve 62 95 36 75 43 59; curve 50 45 68 37 64 29; curve 48 21 27 40 20 70; close; fill ribbon; }
path silkEdge { move 13 63; curve 27 25 50 11 69 20; curve 81 28 72 44 62 51; fill none; stroke #E3FFF3 2; cap round; }
path lowerFold { move 44 59; quad 56 71 88 81; quad 61 82 50 72; close; fill #435D9B; }
