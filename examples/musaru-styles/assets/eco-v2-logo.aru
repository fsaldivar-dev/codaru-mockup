// Musaru Frutiger Eco · original editable botanical forms.
canvas 96 96
background none
gradient leaf linear 110 { stop 0 #ECF4BE; stop 0.4 #AFD07B; stop 0.6 #6B995C; stop 1 #34674A }
gradient tender linear 45 { stop 0 #F6F7D5; stop 0.55 #CDE09E; stop 1 #8FB574 }
gradient glass linear 100 { stop 0 #FFFFFFAF; stop 0.45 #D9E8C64D; stop 0.78 #C1D6B34D; stop 1 #F6FBE2CC }
gradient earth linear 90 { stop 0 #EFF0D5; stop 0.55 #DFE5BE; stop 1 #B8CA9B }
path stem { move 47 84; curve 41 61 46 35 64 15; fill none; stroke #254738 3; cap round; }
path leftLeaf { move 44 60; curve 14 61 10 31 12 19; curve 38 18 58 34 44 60; close; fill leaf; }
path rightLeaf { move 49 44; curve 42 18 68 9 85 11; curve 87 35 72 51 49 44; close; fill tender; }
path vein { move 18 27; quad 40 37 44 60; move 53 38; line 77 18; fill none; stroke #F3F6D8 1.5; cap round; }
