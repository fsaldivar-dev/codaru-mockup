// Musaru orbital receiver · original editable industrial assembly.
canvas 48 48
background none
gradient titanium linear 90 { stop 0 #73848C; stop 0.08 #43545F; stop 0.46 #273944; stop 0.88 #23333D; stop 1 #101D26 }
gradient bezel linear 90 { stop 0 #16252E; stop 0.46 #0B161F; stop 1 #72858D }
gradient metal linear 90 { stop 0 #D2DBDC; stop 0.2 #80939D; stop 0.49 #4A5D69; stop 0.51 #273A47; stop 0.8 #6A7E88; stop 1 #B0C0C6 }
gradient key linear 90 { stop 0 #5A6F7A; stop 0.15 #314753; stop 0.85 #1B303D; stop 1 #10222E }
gradient amber linear 90 { stop 0 #FFE0AB; stop 0.2 #FFD18A; stop 0.8 #F3AF55; stop 1 #D58A32 }
circle socket { at 24 24; radius 19; fill #101F29; }
circle metalRing { at 24 24; radius 14; fill metal; }
circle lens { at 24 24; radius 9; fill #FFD18A; }
path reflection { move 18 19; quad 24 14 30 19; fill none; stroke #FFF4D6 1.8; cap round; }
