// Original VENERO concept. Contemporary illustration, not a traditional community emblem.
canvas 480 420
background none
group mesa-abierta {
resource "{\"key\": \"venero-mesa-abierta\", \"kind\": \"illustration\", \"brand\": \"VENERO\", \"purpose\": \"Composici\u00f3n original de una mesa, ma\u00edz y un cuenco; homenaje editorial a cocinar y compartir, sin reproducir un platillo espec\u00edfico; desde 180 px.\", \"identity\": \"Escult\u00f3rico, curvas abiertas y contrapesos; agua, barro y bosque\", \"reusable\": true, \"tags\": [\"venero\", \"amealco\", \"original\"]}"
circle mantel { at 240 210; radius 168; fill #D9B995; stroke none 2 }
group mesa {
path cuenco { move 89 213; line 391 213; curve 372 297 325 332 240 332; curve 155 332 108 297 89 213; close; fill #A4472F; stroke none 2; cap round; join round }
