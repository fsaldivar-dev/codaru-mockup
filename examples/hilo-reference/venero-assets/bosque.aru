// Original VENERO concept. Contemporary illustration, not a traditional community emblem.
canvas 32 32
background none
group bosque {
resource "{\"key\": \"venero-bosque\", \"kind\": \"ui-icon\", \"brand\": \"VENERO\", \"purpose\": \"Bosques y caminos; icono original para 24 px con etiqueta.\", \"identity\": \"Escult\u00f3rico, curvas abiertas y contrapesos; agua, barro y bosque\", \"reusable\": true, \"tags\": [\"venero\", \"amealco\", \"original\"]}"
path silueta { move 16 3; line 7 15; line 11 15; line 4 24; line 28 24; line 21 15; line 25 15; close; move 16 24; line 16 29; fill none; stroke #233D37 2; cap round; join round }
}
