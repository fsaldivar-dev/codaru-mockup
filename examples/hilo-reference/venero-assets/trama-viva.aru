// Original VENERO concept. Contemporary illustration, not a traditional community emblem.
canvas 480 400
background none
group trama-viva {
resource "{\"key\": \"venero-trama-viva\", \"kind\": \"illustration\", \"brand\": \"VENERO\", \"purpose\": \"Una trama original de bandas de color y cruces abiertos, sin reproducir bordados, mu\u00f1ecas ni atribuir un significado tradicional; desde 180 px.\", \"identity\": \"Escult\u00f3rico, curvas abiertas y contrapesos; agua, barro y bosque\", \"reusable\": true, \"tags\": [\"venero\", \"amealco\", \"original\"]}"
