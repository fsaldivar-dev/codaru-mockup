// ENTRELAZO. Geometría de autor. No reproduce un símbolo tradicional.
canvas 2640 350
background none
group marca {
resource "{\"key\": \"entrelazo-marca\", \"kind\": \"illustration\", \"brand\": \"ENTRELAZO\", \"purpose\": \"Firma vectorial original de nueve letras. Exhibici\u00f3n desde 240 px.\", \"identity\": \"Cruce, continuidad y pausa. Interpretaci\u00f3n contempor\u00e1nea de autor para Amealco.\", \"reusable\": true, \"tags\": [\"entrelazo\", \"amealco\", \"original\"]}"
path letra_0_E_0 { move 210 20; line 20 20; line 20 320; line 210 320; fill none; stroke #283472 7.199999999999999; cap round; join round }
