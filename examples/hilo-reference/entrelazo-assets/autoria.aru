// ENTRELAZO. Geometría de autor. No reproduce un símbolo tradicional.
canvas 24 24
background none
group autoria {
resource "{\"key\": \"entrelazo-autoria\", \"kind\": \"ui-icon\", \"brand\": \"ENTRELAZO\", \"purpose\": \"Abrir autor\u00eda: dos perfiles unidos por una l\u00ednea.\", \"identity\": \"Cruce, continuidad y pausa. Interpretaci\u00f3n contempor\u00e1nea de autor para Amealco.\", \"reusable\": true, \"tags\": [\"entrelazo\", \"amealco\", \"original\"]}"
path hebra_0 { move 3 21; line 3 14; curve 3 9 10 10 10 6; curve 10 2 4 2 4 6; fill none; stroke #283472 1.25; cap round; join round }
path hebra_1 { move 21 21; line 21 14; curve 21 9 14 10 14 6; curve 14 2 20 2 20 6; fill none; stroke #283472 1.25; cap round; join round }
path hebra_2 { move 8 21; line 16 21; fill none; stroke #283472 1.25; cap round; join round }
}
