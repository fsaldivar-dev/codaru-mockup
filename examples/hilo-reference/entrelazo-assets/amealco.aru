// ENTRELAZO. Geometría de autor. No reproduce un símbolo tradicional.
canvas 2040 350
background none
group amealco {
resource "{\"key\": \"entrelazo-amealco\", \"kind\": \"illustration\", \"brand\": \"ENTRELAZO\", \"purpose\": \"Rotulaci\u00f3n original: AMEALCO. Exhibici\u00f3n, no texto de lectura.\", \"identity\": \"Cruce, continuidad y pausa. Interpretaci\u00f3n contempor\u00e1nea de autor para Amealco.\", \"reusable\": true, \"tags\": [\"entrelazo\", \"amealco\", \"original\"]}"
path letra_0_A_0 { move 10 320; line 110 20; line 210 320; fill none; stroke #283472 7.199999999999999; cap round; join round }
path letra_0_A_1 { move 50 220; line 100 220; fill none; stroke #283472 7.199999999999999; cap round; join round }
