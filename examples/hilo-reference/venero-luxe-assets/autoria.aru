// VENERO 02. Original contemporary geometry, not a traditional symbol.
canvas 24 24
background none
group autoria {
resource "{\"kind\": \"ui-icon\", \"purpose\": \"Conocer a los autores: dos perfiles enfrentados, con etiqueta obligatoria.\", \"identity\": \"VENERO 02: tensi\u00f3n, pliegue y vac\u00edo. Interpretaci\u00f3n contempor\u00e1nea original.\", \"reusable\": true, \"tags\": [\"venero-02\", \"amealco\", \"original\"], \"key\": \"venero-02-autoria\", \"brand\": \"VENERO\"}"
path perfil_uno { move 4 20; line 4 14; curve 4 10 10 10 10 6; curve 10 2 4 2 4 6; fill none; stroke #21191D 1.5; cap round; join round }
path perfil_dos { move 20 20; line 20 14; curve 20 10 14 10 14 6; curve 14 2 20 2 20 6; fill none; stroke #21191D 1.5; cap round; join round }
}
