// HILO / caja-altavoz. Original geometry, contemporary interpretation; no attributed traditional meaning.
canvas 32 32
background none
group caja-altavoz {
resource "{\"key\": \"hilo-caja-altavoz\", \"kind\": \"ui-icon\", \"brand\": \"HILO\", \"purpose\": \"Elegir un altavoz; icono de trazo fino para 24 px.\", \"identity\": \"Fine contour, open space and folded ribbon gestures\", \"reusable\": true, \"tags\": [\"hilo\", \"jardin-de-voces\"]}"
path caja { move 9 4; line 23 4; quad 25 4 25 6; line 25 26; quad 25 28 23 28; line 9 28; quad 7 28 7 26; line 7 6; quad 7 4 9 4; close; fill none; stroke #383631 1.65; cap round; join round }
path cono { move 22 21; curve 22 29 10 29 10 21; curve 10 13 22 13 22 21; close; fill none; stroke #383631 1.65; cap round; join round }
path agudo { move 18 9; curve 18 12 14 12 14 9; curve 14 6 18 6 18 9; close; fill none; stroke #383631 1.65; cap round; join round }
}
