// HILO / sumar-playlist. Original geometry, contemporary interpretation; no attributed traditional meaning.
canvas 32 32
background none
group sumar-playlist {
resource "{\"key\": \"hilo-sumar-playlist\", \"kind\": \"ui-icon\", \"brand\": \"HILO\", \"purpose\": \"A\u00f1adir una canci\u00f3n a una playlist; icono de trazo fino para 24 px.\", \"identity\": \"Fine contour, open space and folded ribbon gestures\", \"reusable\": true, \"tags\": [\"hilo\", \"jardin-de-voces\"]}"
path lista { move 5 7; curve 11 6 18 6 24 7; move 5 14; line 16 14; move 5 21; line 13 21; fill none; stroke #383631 1.65; cap round; join round }
path suma { move 23 17; line 23 28; move 18 22.5; line 28 22.5; fill none; stroke #383631 1.65; cap round; join round }
}
