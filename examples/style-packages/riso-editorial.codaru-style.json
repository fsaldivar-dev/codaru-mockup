  "guidance": {
    "composition": [
      "Contrapón una columna de índice estrecha con un bloque editorial dominante. Deja márgenes de impresión generosos.",
      "Usa reglas horizontales, números de edición y asimetría; evita convertir cada contenido en una tarjeta."
    ],
    "typography": [
      "Titulares serif de gran contraste; anotaciones mono pequeñas. Preserva una lectura cómoda en el cuerpo."
    ],
    "controls": [
      "Botones planos con borde de tinta y esquinas rectas. Estados activos como subrayados o sellos.",
      "Los controles de audio pueden tomar forma de marcadores impresos, manteniendo su función reconocible."
    ],
    "mobile": [
      "Diseña una portada vertical con un titular y una imagen dominantes; sustituye el índice lateral por una lista desplegable.",
      "El reproductor ocupa su propia franja editorial; deja controles táctiles amplios y no miniaturices el escritorio."
    ],
    "motion": [
      "Transiciones cortas de opacidad y desplazamiento de página. Respeta movimiento reducido."
    ],
    "avoid": [
      "Sombras de tarjetas SaaS, barras de cristal flotantes y rejillas de tarjetas idénticas.",
      "Texturas que reduzcan el contraste o iconos de trazo indistinguible a 24 px."
    ]
  },
  "aru": {
    "palette": [
      "#d64d32",
      "#23362e",
      "#e5c548",
      "#f4efde"
    ],
    "instructions": [
      "Construye siluetas con dos tintas y grupos semánticos editables.",
      "Desalineación de impresión sutil solo en ilustraciones grandes; iconos limpios y reconocibles a 24 px."
    ]
  }
}
