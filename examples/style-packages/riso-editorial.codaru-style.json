{
  "format": "codaru-style/1",
  "id": "riso-editorial",
  "name": "Risografía editorial",
  "version": "1.0.0",
  "description": "Papel cálido, tintas superpuestas y composición editorial. Un lenguaje para interpretar cada pantalla, no una plantilla.",
  "theme": {
    "id": "riso-editorial",
    "name": "Risografía editorial",
    "modes": {
      "light": {
        "colors": {
          "primary": "#d64d32",
          "surface": "#fff9e9",
          "background": "#f4efde",
          "text": "#23362e",
          "muted": "#626858",
          "border": "#23362e",
          "accent": "#e5c548"
        },
        "gradients": {
          "brand": {
            "name": "Sobreimpresión",
            "type": "linear",
            "angle": 12,
            "stops": [
              {
                "color": "@primary",
                "position": 0
              },
              {
                "color": "@accent",
                "position": 100
              }
            ]
          }
        },
        "materials": {
          "glass": {
            "name": "Cristal",
            "tint": "@surface",
            "opacity": 64,
            "blur": 16,
            "saturation": 150,
            "stroke": "@border",
            "shadow": 16
          }
        },
        "typography": {
          "body": {
            "name": "Cuerpo",
            "fontFamily": "serif",
            "fontSize": 16,
