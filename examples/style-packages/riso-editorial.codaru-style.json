            "lineHeight": 1.4
          },
          "heading": {
            "name": "Titular editorial",
            "fontFamily": "serif",
            "fontSize": 40,
            "fontWeight": 700,
            "lineHeight": 1.1
          }
        },
        "radii": {
          "control": 0,
          "panel": 2
        }
      },
      "dark": {
        "colors": {
          "primary": "#ff8664",
          "surface": "#23362e",
          "background": "#192b25",
          "text": "#f4efde",
          "muted": "#c5c4ac",
          "border": "#c5c4ac",
          "accent": "#e5c548"
        },
        "gradients": {
          "brand": {
            "name": "Sobreimpresión",
            "type": "linear",
            "angle": 12,
            "stops": [
              {
                "color": "@primary",
                "position": 0
              },
              {
                "color": "@accent",
                "position": 100
              }
            ]
          }
        },
        "materials": {
